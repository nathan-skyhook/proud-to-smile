---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const ZOCDOC_URL =
  'https://www.zocdoc.com/practice/proud-to-smile-dentistry-90291?lock=true&referrerType=widget';

const testimonials = [
  {
    quote:
      "I have been going to Dr. Patti for the last 25 years. She is the best. Her practice is very tech savvy unlike other dentists.",
    author: 'Naresh P.',
  },
  {
    quote: 'Dr. Patti and her staff are the best. She is very skillful and knowledgeable.',
    author: 'Malinee S.',
  },
  {
    quote: "Dr Patti is not only efficient and knowledgeable, but she's also one of the most empathetic, kind, and personable dentists I've ever met.",
    author: 'Jose O.',
  },
];

// Same 14 services as ServicesGrid.astro — reproduced here so this concept
// page can style its own card treatment without touching the shared
// component used on real pages.
const services = [
  { title: 'Cleanings', slug: 'cleaning' },
  { title: 'Veneers', slug: 'veneers' },
  { title: 'Teeth Whitening', slug: 'teeth-whitening' },
  { title: 'Emergency Dentistry', slug: 'emergency-dentistry' },
  { title: 'Crowns', slug: 'crowns' },
  { title: 'Clear Aligner Therapy', slug: 'invisalign' },
  { title: 'Dental Implants', slug: 'dental-implants' },
  { title: 'Botox', slug: 'botox' },
  { title: 'Dentures', slug: 'dentures' },
  { title: 'Periodontal Therapy', slug: 'periodontal-therapy' },
  { title: 'Cosmetic & Restorative Dentistry', slug: 'cosmetic-and-restorative-dentistry' },
  { title: 'Extractions & Oral Surgery', slug: 'extractions-oral-surgery' },
  { title: 'Pediatric Dentistry', slug: 'pediatric-dentistry' },
  { title: 'Sleep Apnea Treatment', slug: 'sleep-apnea' },
];

const steps = [
  {
    title: 'New Patients',
    text: 'Getting started with better dental health is simple. Learn what to expect before your first visit.',
    href: '/patient-center/new-patients/',
    label: 'Get More Information',
  },
  {
    title: 'Patient Forms',
    text: 'Save time by completing your new-patient paperwork online before you arrive.',
    href: '/patient-center/patient-forms/',
    label: 'Download Forms',
  },
  {
    title: 'Insurance',
    text: 'We work with most major insurance providers to help maximize your benefits.',
    href: '/patient-center/insurance/',
    label: 'Am I Covered?',
  },
  {
    title: 'Pricing',
    text: 'Quality dental care should be accessible — explore transparent pricing and payment options.',
    href: '/patient-center/pricing/',
    label: 'Learn More About Pricing',
  },
];
---

<BaseLayout
  title="Homepage Concept B (Preview) | Proud To Smile Dentistry"
  description="Alternate homepage design concept — internal review only."
  noindex={true}
>
  <p class="bg-neutral-900 py-2 text-center text-xs text-white">
    Design Concept B — internal preview only ·
    <a href="/" class="underline hover:text-accent-200">View Concept A</a>
  </p>

  <Header currentPath="/" />

  <main id="main-content">
    <!-- Hero -->
    <section class="relative overflow-hidden bg-primary-50">
      <div class="mx-auto grid max-w-7xl grid-cols-1 items-center gap-10 px-4 pb-24 pt-16 sm:px-6 lg:grid-cols-2 lg:gap-16 lg:px-8 lg:pb-28 lg:pt-24">
        <div>
          <span class="inline-flex items-center rounded-full bg-white px-4 py-1.5 text-xs font-semibold uppercase tracking-wide text-primary-700 shadow-sm">
            Bernardsville, NJ &middot; Family &amp; Cosmetic Dentistry
          </span>
          <h1 class="mt-5 text-neutral-900">You&rsquo;ve found your dental home in Bernardsville, NJ</h1>
          <p class="mt-6 max-w-xl text-lg text-neutral-700">
            Comprehensive general and cosmetic dentistry from a team that treats you like family —
            modern technology, genuine compassion, and over 25 years of experience under one roof.
          </p>
          <div class="mt-8 flex flex-wrap gap-4">
            <a href={ZOCDOC_URL} target="_blank" rel="noopener" class="btn2 btn2-primary">
              Schedule Appointment
            </a>
            <a href="tel:+19082211188" class="btn2 btn2-outline">Call 908-221-1188</a>
          </div>
        </div>

        <div class="relative">
          <div class="pointer-events-none absolute -right-8 -top-8 h-56 w-56 rounded-full bg-accent-200/60 blur-3xl" aria-hidden="true"></div>
          <div class="pointer-events-none absolute -bottom-10 -left-10 h-48 w-48 rounded-full bg-secondary-200/50 blur-3xl" aria-hidden="true"></div>
          <img
            src="/images/proudtosmile/hero-woman-at-dentist.webp"
            alt="Smiling patient at Proud To Smile Dentistry in Bernardsville, NJ"
            width="1420"
            height="700"
            loading="eager"
            fetchpriority="high"
            decoding="sync"
            class="relative w-full rounded-[var(--radius-lg)] object-cover shadow-xl"
          />
          <div class="absolute -bottom-6 left-6 flex items-center gap-2 rounded-2xl bg-white px-5 py-3 shadow-lg sm:left-8">
            <span class="flex" aria-hidden="true">
              {Array.from({ length: 5 }).map(() => (
                <svg class="h-4 w-4 fill-current text-primary-600" viewBox="0 0 20 20">
                  <path d="M10 1.5l2.6 5.27 5.82.85-4.21 4.1.99 5.8L10 14.9l-5.2 2.62.99-5.8-4.21-4.1 5.82-.85L10 1.5Z" />
                </svg>
              ))}
            </span>
            <span class="text-sm">
              <span class="font-semibold text-neutral-900">4.96</span>
              <span class="text-neutral-700">on Google</span>
            </span>
          </div>
        </div>
      </div>
    </section>

    <!-- Insurance strip -->
    <div class="relative z-10 mx-auto -mt-10 max-w-5xl px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col items-center justify-between gap-4 rounded-2xl bg-white p-6 shadow-lg sm:flex-row sm:p-8">
        <p class="text-center text-neutral-900 sm:text-left">
          <span class="font-semibold">We accept all major insurance providers.</span>
          <span class="block text-sm text-neutral-700 sm:inline"> See how your plan applies to treatment.</span>
        </p>
        <a href="/patient-center/insurance/" class="btn2 btn2-primary shrink-0">Am I Covered?</a>
      </div>
    </div>

    <!-- What Sets Us Apart -->
    <section class="py-[var(--spacing-section)]" aria-labelledby="apart-heading">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2">
          <div class="lg:order-2">
            <img
              src="/images/proudtosmile/office-collage.webp"
              alt="Collage of the Proud To Smile Dentistry office and team with a patient"
              width="654"
              height="599"
              loading="lazy"
              class="w-full rounded-[var(--radius-lg)] object-cover shadow-xl"
            />
          </div>
          <div class="lg:order-1">
            <h2 id="apart-heading">What Sets Us Apart</h2>
            <p class="mt-4 text-lg text-neutral-700">
              Patients choose Proud To Smile because we're a warm, welcoming place to be — not a
              run-of-the-mill dental office. We blend modern, state-of-the-art dentistry with a
              close-knit team that genuinely cares.
            </p>
            <ol class="mt-10 space-y-8 border-l-2 border-primary-100 pl-8">
              <li class="relative">
                <span class="absolute -left-[2.6rem] flex h-8 w-8 items-center justify-center rounded-full bg-primary-600 text-sm font-bold text-white">1</span>
                <h3>Meet Our Doctors</h3>
                <p class="mt-1 text-neutral-700">
                  Dr. Patricia Swaintek-Lamb brings over 25 years of experience and a reputation as
                  a recognized speaker and mentor in the dental profession.
                </p>
                <a href="/doctors/" class="mt-2 inline-flex items-center gap-1 font-semibold text-primary-700 hover:underline">
                  Meet Our Doctors <span aria-hidden="true">→</span>
                </a>
              </li>
              <li class="relative">
                <span class="absolute -left-[2.6rem] flex h-8 w-8 items-center justify-center rounded-full bg-primary-600 text-sm font-bold text-white">2</span>
                <h3>About Us</h3>
                <p class="mt-1 text-neutral-700">
                  We take a holistic approach to dental treatment, because oral health affects the
                  health of your whole body.
                </p>
                <a href="/about/" class="mt-2 inline-flex items-center gap-1 font-semibold text-primary-700 hover:underline">
                  Learn More About Us <span aria-hidden="true">→</span>
                </a>
              </li>
              <li class="relative">
                <span class="absolute -left-[2.6rem] flex h-8 w-8 items-center justify-center rounded-full bg-primary-600 text-sm font-bold text-white">3</span>
                <h3>New Patients</h3>
                <p class="mt-1 text-neutral-700">
                  Hand warmers, scented pillows, and entertainment help make every visit pleasant —
                  see what to expect before you come in.
                </p>
                <a href="/patient-center/new-patients/" class="mt-2 inline-flex items-center gap-1 font-semibold text-primary-700 hover:underline">
                  Get More Information <span aria-hidden="true">→</span>
                </a>
              </li>
            </ol>
          </div>
        </div>
      </div>
    </section>

    <!-- Testimonials -->
    <section class="bg-secondary-600 py-[var(--spacing-section)] text-white" aria-labelledby="testimonials-heading">
      <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
        <h2 id="testimonials-heading" class="text-center text-white">What Our Patients Say</h2>

        <div
          class="testimonial-carousel relative mt-14"
          role="region"
          aria-roledescription="carousel"
          aria-label="Patient testimonials"
        >
          <div id="testimonial-track" class="testimonial-track" tabindex="0">
            {testimonials.map((t, i) => (
              <div
                class="testimonial-slide"
                role="group"
                aria-roledescription="slide"
                aria-label={`${i + 1} of ${testimonials.length}`}
              >
                <blockquote class="text-center">
                  <svg class="mx-auto h-10 w-10 text-accent-200/70" viewBox="0 0 32 24" fill="currentColor" aria-hidden="true">
                    <path d="M9.4 0C4.2 3.2 0 8.9 0 15.3 0 20.4 3.3 24 8 24c4.2 0 7-3.1 7-6.9 0-3.6-2.5-6.2-5.8-6.2-.6 0-1.2.1-1.5.2C8.3 7 11.6 3.4 15.6 1.2L9.4 0Zm17.4 0c-5.2 3.2-9.4 8.9-9.4 15.3 0 5.1 3.3 8.7 8 8.7 4.2 0 7-3.1 7-6.9 0-3.6-2.5-6.2-5.8-6.2-.6 0-1.2.1-1.5.2C25.7 7 29 3.4 33 1.2L26.8 0Z" transform="translate(0 0)" />
                  </svg>
                  <p class="mt-4 text-xl leading-relaxed">{t.quote}</p>
                  <div class="mt-6 flex items-center justify-center gap-3">
                    <span class="flex h-9 w-9 items-center justify-center rounded-full bg-white/10 text-sm font-semibold">
                      {t.author.charAt(0)}
                    </span>
                    <span class="text-sm font-semibold text-white/90">{t.author}</span>
                  </div>
                </blockquote>
              </div>
            ))}
          </div>

          <div class="sr-only" aria-live="polite" id="testimonial-status"></div>

          <div class="mt-10 flex items-center justify-center gap-6">
            <button
              type="button"
              id="testimonial-prev"
              class="testimonial-arrow"
              aria-label="Previous testimonial"
            >
              <svg class="h-4 w-4" viewBox="0 0 20 20" fill="none" stroke="currentColor" aria-hidden="true">
                <path d="M12.5 4.5 6.5 10l6 5.5" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </button>

            <div id="testimonial-dots" class="flex items-center gap-2">
              {testimonials.map((t, i) => (
                <button
                  type="button"
                  class="testimonial-dot"
                  aria-label={`Go to testimonial ${i + 1} of ${testimonials.length}`}
                  aria-current={i === 0 ? 'true' : 'false'}
                  data-index={i}
                />
              ))}
            </div>

            <button
              type="button"
              id="testimonial-next"
              class="testimonial-arrow"
              aria-label="Next testimonial"
            >
              <svg class="h-4 w-4" viewBox="0 0 20 20" fill="none" stroke="currentColor" aria-hidden="true">
                <path d="m7.5 4.5 6 5.5-6 5.5" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </button>
          </div>
        </div>

        <div class="mt-10 text-center">
          <a href="/testimonials/" class="btn2 btn2-outline-dark">Read All Reviews</a>
        </div>
      </div>
    </section>

    <!-- Services grid -->
    <section class="py-[var(--spacing-section)]" aria-labelledby="services-heading">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mx-auto max-w-2xl text-center">
          <h2 id="services-heading">Discover Quality Dental Care for Every Smile</h2>
          <p class="mt-4 text-lg text-neutral-700">
            From routine cleanings to complete smile makeovers, explore our comprehensive dental
            services — cosmetic, family, and general dentistry &amp; orthodontic care, all under one
            roof in Bernardsville.
          </p>
        </div>
        <div class="mt-12 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
          {services.map((service) => (
            <div class="service-card group flex flex-col overflow-hidden rounded-2xl bg-white shadow-md transition-all hover:-translate-y-1 hover:shadow-xl">
              <div class="h-1.5 bg-gradient-to-r from-primary-600 to-secondary-600"></div>
              <div class="flex flex-1 flex-col p-6">
                <h3 class="flex-1 text-xl">{service.title}</h3>
                <a
                  href={`/service/${service.slug}/`}
                  class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-primary-700 group-hover:underline"
                >
                  Learn More <span aria-hidden="true">→</span>
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Everything You Need -->
    <section class="bg-accent-50 py-[var(--spacing-section)]" aria-labelledby="need-heading">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mx-auto max-w-2xl text-center">
          <h2 id="need-heading">Everything You Need for Better Dental Care</h2>
          <p class="mt-4 text-lg text-neutral-700">
            We're committed to making your dental care experience smooth and stress-free.
          </p>
        </div>
        <div class="relative mt-16 grid grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-4">
          <div class="pointer-events-none absolute left-0 right-0 top-6 hidden border-t-2 border-dashed border-primary-200 lg:block" aria-hidden="true"></div>
          {steps.map((step, i) => (
            <div class="relative text-center">
              <span class="relative z-10 mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-primary-600 text-lg font-bold text-white">
                {i + 1}
              </span>
              <h3 class="mt-4">{step.title}</h3>
              <p class="mt-2 text-sm text-neutral-700">{step.text}</p>
              <a href={step.href} class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-primary-700 hover:underline">
                {step.label} <span aria-hidden="true">→</span>
              </a>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Closing CTA -->
    <section class="bg-gradient-to-br from-primary-600 to-secondary-600 py-[var(--spacing-section)]" aria-labelledby="cta-heading">
      <div class="mx-auto max-w-3xl px-4 text-center sm:px-6 lg:px-8">
        <h2 id="cta-heading" class="text-white">Begin Your Journey to Better Dental Health</h2>
        <p class="mt-4 text-lg text-white/85">
          Transform your smile with our expert team. We offer flexible appointment times and
          personalized care to help you achieve your healthiest smile.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-4">
          <a href={ZOCDOC_URL} target="_blank" rel="noopener" class="btn2 btn2-on-dark">
            Schedule Appointment
          </a>
          <a href="tel:+19082211188" class="btn2 btn2-outline-dark">Call 908-221-1188</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  @reference "../styles/global.css";

  /* Rounded-corner button language (vs. the pill buttons in Concept A) —
     scoped to this page only so it doesn't affect the shared .btn system. */
  .btn2 {
    @apply inline-flex min-h-11 items-center gap-2 rounded-xl px-6 py-2.5 text-sm font-semibold shadow-sm transition-all hover:-translate-y-0.5 hover:shadow-md;
  }
  .btn2-primary {
    @apply bg-primary-600 text-white hover:bg-primary-700;
  }
  .btn2-outline {
    @apply border-2 border-primary-600 bg-white text-primary-700 hover:bg-primary-50;
  }
  .btn2-on-dark {
    @apply bg-white text-primary-700 hover:bg-primary-50;
  }
  .btn2-outline-dark {
    @apply border-2 border-white/50 bg-transparent text-white hover:bg-white/10;
  }

  /* Testimonial slider */
  .testimonial-track {
    @apply flex overflow-x-auto scroll-smooth outline-none;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .testimonial-track::-webkit-scrollbar {
    display: none;
  }
  .testimonial-slide {
    @apply w-full shrink-0;
    scroll-snap-align: center;
  }
  .testimonial-arrow {
    @apply flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-white/10 text-white transition-colors hover:bg-white/20;
  }
  .testimonial-dot {
    @apply h-2.5 w-2.5 rounded-full bg-white/30 transition-all hover:bg-white/50;
  }
  .testimonial-dot[aria-current='true'] {
    @apply w-6 bg-white;
  }

  @media (prefers-reduced-motion: reduce) {
    .testimonial-track {
      scroll-behavior: auto;
    }
  }
</style>

<script>
  const track = document.getElementById('testimonial-track');
  const slides = track ? Array.from(track.children) : [];
  const prevBtn = document.getElementById('testimonial-prev');
  const nextBtn = document.getElementById('testimonial-next');
  const dots = Array.from(document.querySelectorAll('#testimonial-dots .testimonial-dot'));
  const status = document.getElementById('testimonial-status');

  let current = 0;

  const setActive = (index: number) => {
    current = index;
    dots.forEach((dot, i) => dot.setAttribute('aria-current', String(i === index)));
    if (status) status.textContent = `Testimonial ${index + 1} of ${slides.length}`;
  };

  const goTo = (index: number) => {
    const clamped = Math.max(0, Math.min(slides.length - 1, index));
    slides[clamped]?.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
  };

  prevBtn?.addEventListener('click', () => goTo(current - 1));
  nextBtn?.addEventListener('click', () => goTo(current + 1));
  dots.forEach((dot, i) => dot.addEventListener('click', () => goTo(i)));

  track?.addEventListener('keydown', (event) => {
    if (event.key === 'ArrowRight') {
      event.preventDefault();
      goTo(current + 1);
    } else if (event.key === 'ArrowLeft') {
      event.preventDefault();
      goTo(current - 1);
    }
  });

  if (track && slides.length) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting && entry.intersectionRatio > 0.6) {
            setActive(slides.indexOf(entry.target));
          }
        });
      },
      { root: track, threshold: [0.6] }
    );
    slides.forEach((slide) => observer.observe(slide));
    setActive(0);
  }
</script>
