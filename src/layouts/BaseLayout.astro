---
import '../styles/global.css';
import SEOHead from '../components/SEOHead.astro';
import StructuredData from '../components/StructuredData.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const {
  title,
  description = 'Cosmetic, Family, and General Dentistry & Orthodontic Dentistry in Bernardsville, NJ.',
  image,
  noindex = false,
} = Astro.props;

// Site-wide structured data — source: reference/content-proudtosmile.md section 1
const organizationData = {
  name: 'Proud To Smile Dentistry',
  url: Astro.site?.href,
  logo: new URL('/images/proudtosmile/logo.webp', Astro.site).href,
  image: new URL('/images/proudtosmile/logo.webp', Astro.site).href,
  telephone: '+1-908-221-1188',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '10 Anderson Hill Road',
    addressLocality: 'Bernardsville',
    addressRegion: 'NJ',
    postalCode: '07924',
    addressCountry: 'US',
  },
  sameAs: [
    'https://www.facebook.com/Proudtosmile/',
    'https://www.instagram.com/proudtosmile/',
    'https://www.youtube.com/channel/UClzPIteZ-7o4VpC3dbZ2UFA',
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Preconnect to external origins (fonts, analytics) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Google Fonts with font-display: swap for performance -->
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- Favicon set (derived from public/images/proudtosmile/practice-icon.webp) -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />

    <!-- Theme color for browser UI -->
    <meta name="theme-color" content="#1249E9" />

    <!-- SEO Meta Tags (includes Open Graph and Twitter Cards) -->
    <SEOHead
      title={title}
      description={description}
      image={image}
      noindex={noindex}
    />

    <!-- Dentist / LocalBusiness Structured Data (site-wide) -->
    <StructuredData type="LocalBusiness" data={{ '@type': 'Dentist', ...organizationData }} />
  </head>
  <body class="font-body text-neutral-900 bg-white antialiased">
    <slot />
  </body>
</html>
