---
// component-builder: Hero
// Purpose: Homepage hero — headline, subhead, dual CTA, Google rating trust
// signal, and the LCP-critical hero photograph.

const ZOCDOC_URL =
  'https://www.zocdoc.com/practice/proud-to-smile-dentistry-90291?lock=true&referrerType=widget';
---

<section class="relative overflow-hidden bg-gradient-to-br from-primary-50 via-white to-secondary-50">
  <div class="mx-auto grid max-w-7xl grid-cols-1 items-center gap-10 px-4 py-16 sm:px-6 lg:grid-cols-2 lg:gap-16 lg:px-8 lg:py-24">
    <div>
      <h1 class="text-neutral-900">You've found your dental home in Bernardsville, NJ</h1>
      <p class="mt-6 max-w-xl text-lg text-neutral-700">
        Comprehensive general and cosmetic dentistry from a team that treats you like family —
        modern technology, genuine compassion, and over 25 years of experience under one roof.
      </p>
      <div class="mt-8 flex flex-wrap gap-4">
        <a href={ZOCDOC_URL} target="_blank" rel="noopener" class="btn btn-primary">
          Schedule Appointment
        </a>
        <a href="tel:+19082211188" class="btn btn-outline">Call 908-221-1188</a>
      </div>
      <div class="mt-8 flex items-center gap-2 text-sm text-neutral-700">
        <span class="flex" aria-hidden="true">
          {Array.from({ length: 5 }).map(() => (
            <svg class="h-5 w-5 fill-current text-primary-600" viewBox="0 0 20 20">
              <path d="M10 1.5l2.6 5.27 5.82.85-4.21 4.1.99 5.8L10 14.9l-5.2 2.62.99-5.8-4.21-4.1 5.82-.85L10 1.5Z" />
            </svg>
          ))}
        </span>
        <span class="font-semibold text-neutral-900">4.96</span>
        <span>on Google</span>
      </div>
    </div>

    <div class="relative">
      <img
        src="/images/proudtosmile/hero-woman-at-dentist.webp"
        alt="Smiling patient at Proud To Smile Dentistry in Bernardsville, NJ"
        width="1420"
        height="700"
        loading="eager"
        fetchpriority="high"
        decoding="sync"
        class="w-full rounded-lg border border-border object-cover"
      />
    </div>
  </div>
</section>
